{
  "name": "course-report",
  "seed": 2024,
  "size_pairs": [
    [16, 16], [32, 32], [64, 64], [128, 128], [256, 256],
    [32, 64], [32, 128], [32, 256],
    [64, 32], [128, 32], [256, 32]
  ],
  "scenarios": ["smooth", "random_walk", "outliers", "undersampled", "repeated"],
  "deltas": [0.05, 0.15, 0.3],
  "repetitions": 5,
  "warmups": 1,
  "algorithms": [
    "ordinary_discrete_frechet",
    "deletions_only",
    "insertions_only",
    "insertions_and_deletions"
  ],
  "noise": 0.03,
  "corruption_rate": 0.1,
  "outlier_scale": 1.5,
  "include_references": true,
  "reference_max_m": 128,
  "reference_max_cells": 16384,
  "include_mu_benchmarks": true,
  "mu_reference_max_m": 64,
  "measure_memory": true,
  "metadata": {
    "purpose": "Primary reproducible dataset for the course report.",
    "hypotheses": [
      "Deletion-only runtime grows with m*n.",
      "Insertion-based runtime grows with m^2 + m*n.",
      "The monotonic queue and optimized mu preprocessing outperform direct references as m grows.",
      "Combined edits are feasible at least whenever either restricted edit model is feasible."
    ]
  }
}
